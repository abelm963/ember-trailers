<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build for Jellyfin 12.x (default, matches Hearth 12.1):   dotnet build -c Release
    Build for Jellyfin 10.11.x:          dotnet build -c Release -p:JellyfinTarget=10.11
  -->
  <PropertyGroup>
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">12</JellyfinTarget>
    <TargetFramework Condition="'$(JellyfinTarget)' == '12'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinTarget)' == '10.11'">net9.0</TargetFramework>
    <DefineConstants Condition="'$(JellyfinTarget)' == '10.11'">$(DefineConstants);JF1011</DefineConstants>
    <RootNamespace>Jellyfin.Plugin.EmberTrailers</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="'$(JellyfinTarget)' == '12'">
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(JellyfinTarget)' == '10.11'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CalendarProbe" />
  </ItemGroup>
</Project>
